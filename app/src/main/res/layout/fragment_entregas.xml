<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="16dp">

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/tv_entregas_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Módulo de Entregas y Recepción"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 
        NOTA DE CONFIGURACIÓN:
        Este RecyclerView (rv_main_dashboard) se configurará más adelante en el código Kotlin 
        utilizando un GridLayoutManager (por ejemplo: rv_main_dashboard.layoutManager = GridLayoutManager(context, 2 o 3)) 
        para desplegar las tarjetas de control de entregas de mercancías APPCC.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_main_dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_entregas_header"
        tools:listitem="@android:layout/simple_list_item_2" />

</androidx.constraintlayout.widget.ConstraintLayout>
